{
  "name": "@localix-ai/flowapi",
  "version": "0.3.0",
  "description": "TypeScript types from OpenAPI 3.0, 3.1, 3.2 and JSON Schema that follow the specification: every value a schema accepts, its type accepts. The Rust generator compiled to WebAssembly, for Node, Bun, Deno and browsers, with no runtime dependency.",
  "keywords": [
    "api",
    "codegen",
    "generator",
    "json-schema",
    "openapi",
    "openapi3",
    "swagger",
    "typescript",
    "types",
    "wasm",
    "webassembly",
    "zero-dependency"
  ],
  "homepage": "https://flowapi.localix.ai",
  "bugs": {
    "url": "https://github.com/localixai/flowapi/issues"
  },
  "license": "MIT",
  "author": "Localix Lab (https://localix.ai)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/localixai/flowapi.git",
    "directory": "npm"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "bin": {
    "flowapi": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./flowapi.wasm": "./dist/flowapi.wasm",
    "./flowapi-sdk.wasm": "./dist/flowapi-sdk.wasm",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "size": "bun scripts/size.ts",
    "check": "bun run build && bun run typecheck && bun run size && publint --strict && attw --pack . --profile esm-only --exclude-entrypoints flowapi.wasm flowapi-sdk.wasm && bun test",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@types/bun": "1.4.5",
    "@types/node": "26.6.6",
    "publint": "0.3.25",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
