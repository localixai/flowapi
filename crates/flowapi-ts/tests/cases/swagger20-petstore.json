{"swagger":"2.0","info":{"title":"Swagger Petstore","version":"1.0.0"},
 "host":"petstore.swagger.io","basePath":"/v2","schemes":["https","http"],
 "consumes":["application/json","application/xml"],"produces":["application/json"],
 "paths":{
  "/pet":{
   "post":{"operationId":"addPet","parameters":[{"in":"body","name":"body","description":"Pet object that needs to be added to the store","required":true,"schema":{"$ref":"#/definitions/Pet"}}],
     "responses":{"405":{"description":"Invalid input"}}},
   "put":{"operationId":"updatePet","consumes":["application/json"],"parameters":[{"in":"body","name":"body","schema":{"$ref":"#/definitions/Pet"}}],
     "responses":{"400":{"$ref":"#/responses/BadRequest"},"404":{"description":"Pet not found"}}}},
  "/pet/findByStatus":{
   "get":{"operationId":"findPetsByStatus","produces":["application/xml","application/json"],
     "parameters":[{"name":"status","in":"query","description":"Status values that need to be considered for filter","required":true,"type":"array","items":{"type":"string","enum":["available","pending","sold"],"default":"available"},"collectionFormat":"multi"},
       {"$ref":"#/parameters/Limit"}],
     "responses":{"200":{"description":"successful operation","schema":{"type":"array","items":{"$ref":"#/definitions/Pet"}},
       "headers":{"X-Rate-Limit":{"type":"integer","format":"int32","description":"calls per hour allowed by the user"},"X-Expires-After":{"type":"string","format":"date-time"},"Content-Type":{"type":"string"}}},
      "400":{"description":"Invalid status value"}}}},
  "/pet/{petId}":{
   "parameters":[{"name":"petId","in":"path","description":"ID of pet","required":true,"type":"integer","format":"int64"}],
   "get":{"operationId":"getPetById","parameters":[{"name":"Accept","in":"header","type":"string"},{"name":"X-Trace","in":"header","type":"string","maxLength":64}],
     "responses":{"200":{"description":"ok","schema":{"$ref":"#/definitions/Pet"}},"default":{"description":"error","schema":{"$ref":"#/definitions/ApiResponse"}}}},
   "delete":{"operationId":"deletePet","deprecated":true,"parameters":[{"name":"api_key","in":"header","required":false,"type":"string"}],
     "responses":{"400":{"description":"Invalid ID supplied"}}},
   "trace":{"operationId":"tracePet","responses":{"200":{"description":"not an operation in 2.0"}}}}},
 "parameters":{"Limit":{"name":"limit","in":"query","type":"integer","minimum":1,"maximum":100,"default":20}},
 "responses":{"BadRequest":{"description":"bad request","schema":{"$ref":"#/definitions/ApiResponse"}}},
 "definitions":{
  "Category":{"type":"object","properties":{"id":{"type":"integer","format":"int64"},"name":{"type":"string"}},"xml":{"name":"Category"}},
  "Tag":{"type":"object","properties":{"id":{"type":"integer","format":"int64"},"name":{"type":"string"}}},
  "Pet":{"type":"object","required":["name","photoUrls"],"properties":{
    "id":{"type":"integer","format":"int64","readOnly":true},
    "category":{"$ref":"#/definitions/Category"},
    "name":{"type":"string","example":"doggie"},
    "photoUrls":{"type":"array","xml":{"name":"photoUrl","wrapped":true},"items":{"type":"string"}},
    "tags":{"type":"array","items":{"$ref":"#/definitions/Tag"}},
    "status":{"type":"string","description":"pet status in the store","enum":["available","pending","sold"]}},
   "externalDocs":{"url":"https://example.com"}},
  "ApiResponse":{"type":"object","properties":{"code":{"type":"integer","format":"int32"},"type":{"type":"string"},"message":{"type":"string"}}}},
 "securityDefinitions":{"api_key":{"type":"apiKey","name":"api_key","in":"header"}}}
