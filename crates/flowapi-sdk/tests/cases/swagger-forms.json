  "req: oas-2.0.parameter-object.type — upload: a `file` field makes the body multipart/form-data, its array field a part of its own",
  "req: oas-2.0.operation-object.consumes — postTags: the form written as the one media type it consumes"
 ],
 "x-flowapi-calls": [
  {"operation": "postTags", "input": {"body": {"contentType": "application/x-www-form-urlencoded", "value": {"shared": ["a", "b"], "csv": ["a", "b"], "multi": ["a", "b"], "ssv": ["a", "b"], "tsv": ["a", "b"], "odd": ["a", "b"], "plain": "p q"}}}, "expect": {"body": "shared=a%7Cb&csv=a,b&multi=a&multi=b&ssv=a%20b&tsv=a%09b&odd=a,b&plain=p+q"}},
  {"operation": "upload", "input": {"body": {"contentType": "multipart/form-data; boundary=XyZ", "value": {"sizes": [1, 2]}}}, "expect": {"body": "--XyZ\r\nContent-Disposition: form-data; name=\"sizes\"\r\n\r\n1,2\r\n--XyZ--\r\n"}}
 ]
}
