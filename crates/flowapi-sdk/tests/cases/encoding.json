       "prefixEncoding": [{ "contentType": "text/plain" }],
       "itemEncoding": { "contentType": "text/plain" }
      },
      "application/json": {
       "schema": { "type": "object" },
       "encoding": { "photo": { "contentType": "image/png" } }
      }
     }
    },
    "responses": {
     "201": {
      "description": "made",
      "content": { "multipart/form-data": { "schema": { "type": "object" }, "encoding": { "photo": { "contentType": "image/png" } } } }
     }
    }
   }
  },
  "/docs": {
