   }
  },
  "/plain": {
   "post": {
    "operationId": "plain",
    "requestBody": { "content": { "multipart/form-data": { "schema": { "type": "object" } } } },
    "responses": { "204": { "description": "kept" } }
   }
  }
 },
 "components": {
  "schemas": {
   "Scan": { "allOf": [{ "$ref": "#/components/schemas/Encoded" }, { "maxLength": 100 }] },
