#!/bin/sh
# Generated by flowapi from flowapi-sdk.yml and the API description. Do not edit: generate again.
#
# The sources type-checked; no node: module in the generated client, which runs wherever fetch
# does; the mock server and the tests parsed.
set -eu
cd "$(dirname "$0")/.."
tsc=node_modules/.bin/tsc
if [ ! -x "$tsc" ]; then
  echo "scripts/lint: $tsc is missing: run npm install first" >&2
  exit 1
fi
"$tsc" -p tsconfig.json
found=$(find src -name '*.ts' ! -path 'src/lib/*' -exec grep -l -e 'from "node:' -e "from 'node:" {} + || true)
if [ -n "$found" ]; then
  echo "scripts/lint: a node: module is imported by the client, which must run without Node:" >&2
  echo "$found" >&2
  exit 1
fi
for f in mock/*.mjs $(find tests -name '*.mjs' | sort); do
  node --check "$f"
done
