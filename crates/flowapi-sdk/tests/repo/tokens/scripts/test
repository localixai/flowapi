#!/bin/sh
# Generated by flowapi from flowapi-sdk.yml and the API description. Do not edit: generate again.
#
# Every test of tests/ by node --test, against the mock server each test file starts on a free
# port (or against TEST_API_BASE_URL when it is set). The package is built first, unless
# SDK_BUILT=1 says it was just built.
set -eu
cd "$(dirname "$0")/.."
if [ "${SDK_BUILT:-}" != 1 ]; then
  scripts/build
fi
files=$(find tests -name '*.test.mjs' | sort)
if [ -z "$files" ]; then
  echo "scripts/test: no tests under tests/" >&2
  exit 1
fi
# The files one by one as arguments: every Node from 20 reads them so, globs or not.
# shellcheck disable=SC2086
node --test $files
