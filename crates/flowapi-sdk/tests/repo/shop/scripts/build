#!/bin/sh
# Generated by flowapi from flowapi-sdk.yml and the API description. Do not edit: generate again.
#
# The package built twice from src/ by tsc alone: ES modules into dist/esm, CommonJS into
# dist/cjs, each with its declarations; then loaded by its own name with require and import, as
# a user loads it.
set -eu
cd "$(dirname "$0")/.."
tsc=node_modules/.bin/tsc
if [ ! -x "$tsc" ]; then
  echo "scripts/build: $tsc is missing: run npm install first" >&2
  exit 1
fi
rm -rf dist
"$tsc" -p tsconfig.build.json
"$tsc" -p tsconfig.cjs.json
printf '{ "type": "commonjs" }\n' > dist/cjs/package.json
name=$(node -p 'require("./package.json").name')
# CommonJS: the module, its client class both `default` and by its name, as the README takes it.
node -e 'const m = require(process.argv[1]); if (typeof m.default !== "function" || m[m.default.name] !== m.default) throw new Error("require(" + process.argv[1] + ") gives no client class by its name")' "$name"
node --input-type=module -e 'const m = await import(process.argv[1]); if (typeof m.default !== "function") throw new Error("import(" + process.argv[1] + ") gives no client class")' "$name"
