{
 "openapi": "3.2.0",
 "info": { "title": "Hosts", "version": "1", "description": "Items kept in two regions." },
 "servers": [
  { "url": "https://{region}.hosts.example/{version}", "variables": { "region": { "default": "eu", "enum": ["eu", "us"] }, "version": { "default": "v1" } } },
  { "url": "./local" }
 ],
 "paths": {
  "/items": {
   "get": { "operationId": "listItems", "summary": "Every item", "responses": { "200": { "$ref": "#/components/responses/Items" } } },
   "post": { "operationId": "createItem", "summary": "Add an item", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Item" } } } }, "responses": { "201": { "$ref": "#/components/responses/One" } } }
  },
  "/items/{id}": {
   "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
   "put": { "operationId": "replaceItem", "summary": "Replace an item", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Item" } } } }, "responses": { "200": { "$ref": "#/components/responses/One" } } },
   "patch": { "operationId": "editItem", "summary": "Change an item", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Item" } } } }, "responses": { "200": { "$ref": "#/components/responses/One" } } },
   "delete": { "operationId": "deleteItem", "summary": "Remove an item", "responses": { "204": { "description": "gone" } } },
   "head": { "operationId": "checkItem", "summary": "Whether an item is there", "responses": { "200": { "description": "there" } } },
   "options": { "operationId": "describeItem", "summary": "What an item allows, asked with a note", "requestBody": { "content": { "text/plain": { "schema": { "type": "string" } } } }, "responses": { "204": { "description": "allowed" } } }
  },
  "/purge": {
   "delete": { "operationId": "purgeItems", "summary": "Remove the items named", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "array", "items": { "type": "integer" } } } } }, "responses": { "204": { "description": "gone" } } }
  },
  "/status": {
   "servers": [{ "url": "." }],
   "get": { "operationId": "localStatus", "summary": "The status where the description is served", "responses": { "200": { "$ref": "#/components/responses/Status" } } }
  },
  "/edge": {
   "get": {
    "operationId": "edgeStatus",
    "summary": "The status at an edge",
    "servers": [{ "url": "https://{zone}.edge.example", "variables": { "zone": { "default": "a", "enum": ["a", "b"] } } }],
    "responses": { "200": { "$ref": "#/components/responses/Status" } }
   }
  }
 },
 "components": {
  "schemas": {
   "Item": { "type": "object", "required": ["name"], "properties": { "id": { "type": "integer" }, "name": { "type": "string" } } }
  },
  "responses": {
   "One": { "description": "the item", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Item" } } } },
   "Items": { "description": "the items", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Item" } } } } },
   "Status": { "description": "the status", "content": { "application/json": { "schema": { "type": "object", "properties": { "up": { "type": "boolean" } } } } } }
  }
 }
}
