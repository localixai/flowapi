{
 "openapi": "3.1.0",
 "info": {
  "title": "bench",
  "version": "1"
 },
 "paths": {
  "/repos/{owner}/{repo}": {
   "get": {
    "operationId": "getRepo",
    "parameters": [
     {
      "name": "owner",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "repo",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "verbose",
      "in": "query",
      "schema": {
       "type": "boolean"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "ok"
     }
    }
   }
  },
  "/search": {
   "get": {
    "operationId": "search",
    "parameters": [
     {
      "name": "tag",
      "in": "query",
      "schema": {
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     },
     {
      "name": "filter",
      "in": "query",
      "style": "deepObject",
      "schema": {
       "type": "object"
      }
     },
     {
      "name": "page",
      "in": "query",
      "schema": {
       "type": "integer"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "ok"
     }
    }
   }
  },
  "/pets/{id}": {
   "put": {
    "operationId": "putPet",
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "integer"
      }
     },
     {
      "name": "dry",
      "in": "query",
      "schema": {
       "type": "boolean"
      }
     },
     {
      "name": "X-Request-Id",
      "in": "header",
      "schema": {
       "type": "string"
      }
     }
    ],
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "type": "object"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "ok"
     }
    }
   }
  }
 }
}
